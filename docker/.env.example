# Copy to the repo root as `.env` and fill in as needed:  cp docker/.env.example .env
# Every key maps to backend/app/config.py (Settings). Compose injects DATABASE_URL/REDIS_URL
# with in-network hostnames automatically; you only need them here for non-Docker runs.

# --- Postgres (compose service) ---------------------------------------------------------
POSTGRES_USER=copytrader
POSTGRES_PASSWORD=copytrader
POSTGRES_DB=copytrader

# --- Polymarket / Polygon endpoints (verify against docs.polymarket.com before wiring) ----
POLYGON_RPC_URLS=
GAMMA_API_URL=https://gamma-api.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com
LEADERBOARD_URL=https://data-api.polymarket.com

# On-chain contract addresses (Polygon, chain id 137); verified against
# docs.polymarket.com/resources/contracts on 2026-07-02. Leave as-is unless Polymarket migrates.
CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
NEG_RISK_CTF_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
CONDITIONAL_TOKENS_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
USDC_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
# Pre-pUSD exchanges — wallet history before the collateral migration lives here
LEGACY_EXCHANGE_ADDRESSES=0x4bFb41d5B3570DeFd03C39a9A4D8dE6Bd8B8982E,0xC5d563A36AE78145C45a50134d48A1215220f80a

# --- Indexer tuning ------------------------------------------------------------------------
CHAIN_CONFIRMATIONS=5
RPC_LOG_CHUNK_SIZE=10000
BACKFILL_START_BLOCK=33605403

# --- Execution (live trading requires BOTH flags AND the kill switch clear) ---------------
EXECUTION_MODE=paper
LIVE_TRADING_ARMED=false

# CLOB credentials + signing key — live execution only; never commit real values
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
WALLET_PRIVATE_KEY=
# Signature scheme: 0 = EOA (signing key holds funds), 1 = email proxy, 2 = browser/Safe proxy.
# Non-EOA schemes trade from CLOB_FUNDER_ADDRESS.
CLOB_SIGNATURE_TYPE=0
CLOB_FUNDER_ADDRESS=

# Live-order tuning (Phase 8): marketable Fill-And-Kill crossing + retry on transient failures
LIVE_MARKETABLE_BUFFER_PCT=1.0
LIVE_MAX_RETRIES=3
LIVE_RETRY_BACKOFF_SECONDS=0.5

# --- Risk limits (USDC unless noted) ------------------------------------------------------
RISK_MAX_TOTAL_EXPOSURE=1000
RISK_MAX_DAILY_LOSS=100
RISK_MAX_WEEKLY_LOSS=250
RISK_MAX_MONTHLY_LOSS=500
RISK_MAX_OPEN_POSITIONS=10
RISK_MAX_POSITION_SIZE=100
RISK_MAX_PER_MARKET_EXPOSURE=200
RISK_MAX_PER_WALLET_EXPOSURE=300
RISK_MIN_MARKET_LIQUIDITY=10000
RISK_MAX_SLIPPAGE_PCT=2.0
RISK_MAX_COPY_DELAY_SECONDS=60
