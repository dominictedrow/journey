{
  "name": "cwork",
  "version": "0.1.0",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.7"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "build": {
    "appId": "com.dom.cwork",
    "productName": "cwork",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "dist/**/*"
    ],
    "extraResources": [
      { "from": "skills", "to": "skills" },
      { "from": "scripts", "to": "scripts" }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg"]
    }
  }
}
