{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Copytrader",
  "version": "0.1.0",
  "identifier": "com.copytrader.desktop",
  "build": {
    "frontendDist": "../../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Copytrader",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "Finance",
    "shortDescription": "Polymarket intelligence & copy-trading dashboard",
    "longDescription": "Thin-client desktop shell for the Copytrader backend. Point it at the Windows test box or the Beelink from Settings — no rebuild needed.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
