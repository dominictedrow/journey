# Downloaded video data: regenerable from the *_downloader.py scripts, and
# both MS-ASL and WLASL are distributed under a Computational Use of Data
# Agreement that restricts redistribution -- don't put clips in git.
data/raw_videos/
data/WLASL/start_kit/videos/

# Extracted MediaPipe landmarks (multi-GB, regenerable via extract_raw_videos.py)
# and the train/val/test split derived from them (regenerable via split_dataset.py).
data/raw_landmarks/
data/split.json
data/kaggle_raw/

# Landmark files quarantined out of the dataset for data-quality reasons
# (zero-detection clips, long multi-gloss WLASL source videos) -- see the
# July 31 data-quality analysis. Same regenerable-multi-GB status as raw_landmarks/.
data/excluded_landmarks/

__pycache__/
*.pyc

# Per-run downloader logs and state.
data/MS-ASL/*.log
data/WLASL/start_kit/*.log
data/MS-ASL/resume*_stdout.log
data/WLASL/start_kit/resume*_stdout.log

# Run logs -- regenerable, not source.
logs/
.gstack/

# Experiment checkpoints and console logs are large, reproducible artifacts.
# Keep their compact metrics/configuration files available for versioning.
models/attention_experiments/*_best.pt
models/attention_experiments/*_latest.pt
models/attention_experiments_40ep/*_best.pt
models/attention_experiments_40ep/*_latest.pt
models/high_priority_tuning/**/*.pt
models/high_priority_tuning/*.log
models/high_priority_tuning/*.pid
models/checkpoint_gelu.pt
models/checkpoint_gelu_forget_bias1_15ep.pt
models/checkpoint_relu_forget_bias1_15ep.pt
