# Copy to .env and fill in. Never commit .env.
# Alpaca PAPER keys only (key id starts with PK)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
FRED_API_KEY=
CONGRESS_API_KEY=          # api.data.gov key
COINGECKO_DEMO_API_KEY=
SOSOVALUE_API_KEY=         # optional: ETF flows; get one at sosovalue.com/developer/dashboard (D-032)
FINNHUB_API_KEY=           # optional; earnings fallback not built yet (D-031)
SEC_EDGAR_USER_AGENT=      # "AppName contact@example.com", required by SEC
POSTGRES_USER=qt
POSTGRES_PASSWORD=
QT_DB_PORT=54320
QT_DB_BACKUP_PORT=54321
DATABASE_URL=postgresql://qt:<password>@localhost:54320/quant_trader
BACKUP_DATABASE_URL=postgresql://qt:<password>@localhost:54321/quant_trader
NTFY_TOPIC=                # long random string; treat as secret (D-016)
QT_PROFILE=dev             # dev | paper | backtest
